{
  "name": "@eclesia/atomone-indexer",
  "version": "2.3.0",
  "description": "",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && tsdown && pnpm postbuild",
    "postbuild": "copyfiles -u 1 \"src/**/*.sql\" dist",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version:packages": "changeset version",
    "release": "node scripts/tag-release.mjs"
  },
  "bin": {
    "ts-indexer": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@atomone/atomone-types": "^4.1.0",
    "@cosmjs/proto-signing": "^0.39.0",
    "@cosmjs/stargate": "^0.39.0",
    "@cosmjs/tendermint-rpc": "^0.39.0",
    "@eclesia/basic-pg-indexer": "^2.16.5",
    "@eclesia/core-modules-pg": "^2.16.5",
    "@eclesia/indexer-engine": "^2.16.5",
    "bignumber.js": "^11.1.5",
    "json-with-bigint": "^3.5.12",
    "pg": "^8.23.0"
  },
  "packageManager": "pnpm@12.4.2",
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@arethetypeswrong/core": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "copyfiles": "^2.4.1",
    "eslint": "^10.11.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.70.1",
    "unrun": "^0.3.1"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
